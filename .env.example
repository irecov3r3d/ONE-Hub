# ========================================
# FOODMARKET MVP - Environment Configuration
# ========================================

# ===========================================
# REQUIRED CONFIGURATION
# ===========================================

# Server port (default: 4000)
PORT=4000

# Node environment (development | production)
NODE_ENV=development

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================

# API base URL for frontend (include protocol, no trailing slash)
# Development: http://localhost:4000
# Production: https://api.yourfoodmarket.com
NEXT_PUBLIC_API_BASE=http://localhost:4000

# ===========================================
# CORS CONFIGURATION (Production)
# ===========================================

# Comma-separated list of allowed origins for CORS
# Leave empty for development (allows all origins)
# Production example: https://yourfoodmarket.com,https://www.yourfoodmarket.com
CORS_WHITELIST=

# ===========================================
# RATE LIMITING (Optional Overrides)
# ===========================================

# Max price reports per device per hour (default: 5)
RATE_LIMIT_REPORTS_PER_HOUR=5

# Max confirmations per device per hour (default: 20)
RATE_LIMIT_CONFIRMS_PER_HOUR=20

# Cooldown between confirmations in minutes (default: 2)
RATE_LIMIT_CONFIRM_COOLDOWN_MIN=2

# ===========================================
# PRICE VALIDATION (Optional Overrides)
# ===========================================

# Minimum allowed price in USD (default: 0.50)
PRICE_MIN=0.50

# Maximum allowed price in USD (default: 50.00)
PRICE_MAX=50.00

# ===========================================
# DATABASE (Optional)
# ===========================================

# SQLite database path (default: ./server/data/foodmarket.db)
# For production, consider using a persistent volume path
DATABASE_PATH=./server/data/foodmarket.db

# ===========================================
# GETTING STARTED
# ===========================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. For local development, the defaults work out of the box.
#    Just run: npm run dev
#
# 3. For production deployment:
#    - Set NODE_ENV=production
#    - Set NEXT_PUBLIC_API_BASE to your API domain
#    - Set CORS_WHITELIST to your frontend domain(s)
#    - Configure a persistent database path
#
# See README.md and SETUP_GUIDE.md for more details!
